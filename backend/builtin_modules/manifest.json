{
  "modules": [
    {
      "moduleId": "passthrough",
      "importPath": "backend.builtin_modules.passthrough",
      "entryFunction": "process",
      "inputs": ["input"],
      "outputs": ["output"],
      "parameters": {}
    },
    {
      "moduleId": "gain",
      "importPath": "backend.builtin_modules.gain",
      "entryFunction": "process",
      "inputs": ["input"],
      "outputs": ["output"],
      "parameters": {
        "gain": {"type": "number", "min": -20, "max": 20, "default": 1}
      }
    },
    {
      "moduleId": "command_shaper",
      "importPath": "backend.builtin_modules.command_shaper",
      "entryFunction": "process",
      "inputs": ["pitch_command"],
      "outputs": ["shaped_command"],
      "parameters": {}
    },
    {
      "moduleId": "attitude_controller",
      "importPath": "backend.builtin_modules.attitude_controller",
      "entryFunction": "process",
      "inputs": ["attitude_error"],
      "outputs": ["torque_command"],
      "parameters": {}
    },
    {
      "moduleId": "control_allocator",
      "importPath": "backend.builtin_modules.control_allocator",
      "entryFunction": "process",
      "inputs": ["torque_command"],
      "outputs": ["motor_total_command"],
      "parameters": {}
    },
    {
      "moduleId": "motor_mixer",
      "importPath": "backend.builtin_modules.motor_mixer",
      "entryFunction": "process",
      "inputs": ["motor_total_command"],
      "outputs": ["motor_1_command", "motor_2_command", "motor_3_command", "motor_4_command"],
      "parameters": {}
    },
    {
      "moduleId": "motor_model",
      "importPath": "backend.builtin_modules.motor_model",
      "entryFunction": "process",
      "inputs": ["motor_command"],
      "outputs": ["thrust"],
      "parameters": {}
    },
    {
      "moduleId": "vehicle_dynamics",
      "importPath": "backend.builtin_modules.vehicle_dynamics",
      "entryFunction": "process",
      "inputs": ["thrust_1", "thrust_2", "thrust_3", "thrust_4"],
      "outputs": ["pitch_rate"],
      "parameters": {}
    },
    {
      "moduleId": "imu_gyro",
      "importPath": "backend.builtin_modules.imu_gyro",
      "entryFunction": "process",
      "inputs": ["body_rate"],
      "outputs": ["measured_rate"],
      "parameters": {}
    },
    {
      "moduleId": "pid_controller",
      "importPath": "backend.builtin_modules.pid_controller",
      "entryFunction": "process",
      "inputs": ["attitude_command", "attitude_feedback"],
      "outputs": ["moment_command"],
      "parameters": {}
    },
    {
      "moduleId": "control_allocation",
      "importPath": "backend.builtin_modules.control_allocation",
      "entryFunction": "process",
      "inputs": ["moment_command", "speed_command", "altitude_command"],
      "outputs": ["actuator_command"],
      "parameters": {
        "allocationGain": {"type": "number", "min": 0, "max": 10, "default": 1}
      }
    },
    {
      "moduleId": "voltage_drop",
      "importPath": "backend.builtin_modules.voltage_drop",
      "entryFunction": "process",
      "inputs": ["actuator_command", "bus_voltage"],
      "outputs": ["voltage_limited_command"],
      "parameters": {}
    },
    {
      "moduleId": "motor_actuator",
      "importPath": "backend.builtin_modules.motor_actuator",
      "entryFunction": "process",
      "inputs": ["voltage_limited_command"],
      "outputs": [
        "rotor_1_command",
        "rotor_2_command",
        "rotor_3_command",
        "rotor_4_command",
        "rotor_5_command",
        "rotor_6_command",
        "rotor_7_command",
        "rotor_8_command"
      ],
      "parameters": {}
    },
    {
      "moduleId": "rotor_motor",
      "importPath": "backend.builtin_modules.rotor_motor",
      "entryFunction": "process",
      "inputs": ["rotor_command"],
      "outputs": ["rotor_thrust"],
      "parameters": {}
    },
    {
      "moduleId": "aero_moment",
      "importPath": "backend.builtin_modules.aero_moment",
      "entryFunction": "process",
      "inputs": [
        "rotor_1_thrust",
        "rotor_2_thrust",
        "rotor_3_thrust",
        "rotor_4_thrust",
        "rotor_5_thrust",
        "rotor_6_thrust",
        "rotor_7_thrust",
        "rotor_8_thrust"
      ],
      "outputs": ["total_force", "total_moment"],
      "parameters": {}
    },
    {
      "moduleId": "six_dof",
      "importPath": "backend.builtin_modules.six_dof",
      "entryFunction": "process",
      "inputs": ["total_force", "total_moment"],
      "outputs": ["attitude", "body_rate", "altitude"],
      "parameters": {}
    },
    {
      "moduleId": "sensor_fault_injection",
      "importPath": "backend.builtin_modules.sensor_fault_injection",
      "entryFunction": "process",
      "inputs": ["attitude", "body_rate", "altitude"],
      "outputs": ["attitude_feedback", "rate_feedback", "altitude_feedback"],
      "parameters": {}
    },
    {
      "moduleId": "barometer_sensor",
      "importPath": "backend.builtin_modules.barometer_sensor",
      "entryFunction": "process",
      "inputs": ["true_altitude"],
      "outputs": ["measured_altitude"],
      "parameters": {
        "bias": {
          "type": "number",
         "min": -1000,
          "max": 1000,
          "default": 0
        },
       "scale": {
         "type": "number",
         "min": 0,
         "max": 10,
         "default": 1
        }
      } 
    }
  ]
}
