GZ_IMAGE_TAG=local
GZ_HTTP_PORT=8080
# Set to 0.0.0.0 if other computers should access this host.
GZ_BIND_ADDRESS=127.0.0.1

# Host directories, relative to compose.yaml (or absolute paths).
# Both directories must exist; the complete directories are mounted read-only.
# auto_components starts empty; add simulation/electrical modules as needed.
GZ_AUTO_COMPONENTS_DIR=./backend/auto_components
GZ_DISPLAY_CONFIG_DIR=./public/config

# Empty disables callbacks for standalone use.
# To call a student service on the Docker host, use:
# PRACTICE_RESULT_CALLBACK_URL=http://host.docker.internal:9000/student/practice/result
PRACTICE_RESULT_CALLBACK_URL=

# If enabled, registration API clients must supply the matching token.
GZ_COMPONENT_REGISTRATION_TOKEN=
