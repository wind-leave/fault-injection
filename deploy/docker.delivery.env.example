GZ_IMAGE_TAG=local
GZ_HTTP_PORT=8080
# Listen on the target machine's network interfaces for access from other computers.
GZ_BIND_ADDRESS=0.0.0.0

# Paths are relative to compose.yaml in the delivery directory.
# backend/ contains component .py files, __init__.py and shared helper code.
# public/ contains display-console.json and palette-menus.json.
GZ_AUTO_COMPONENTS_DIR=./backend
GZ_DISPLAY_CONFIG_DIR=./public

PRACTICE_RESULT_CALLBACK_URL=
GZ_COMPONENT_REGISTRATION_TOKEN=
